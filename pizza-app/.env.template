# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Telemetry lands in the default ingestion dataset configured on the token
# above. To send it somewhere else, change that setting on the token itself —
# a request that names a dataset the token may not write to is rejected and
# the telemetry is dropped.

# Optional: which environment these services report as
DASH0_ENVIRONMENT=workshop

# Optional: the repository this code came from, so telemetry links back to it.
# Change this if you forked the workshop under a different account.
VCS_REPOSITORY_URL=https://github.com/brahim1o1/otel-pizza-workshop

# Optional: OTLP transport. The endpoints above are gRPC (port 4317). Switch to
# http/protobuf only if you also change DASH0_ENDPOINT to the port 4318 form.
DASH0_OTLP_PROTOCOL=grpc

# Optional: set to debug to have the OpenTelemetry SDK explain what it is doing.
# Useful when nothing shows up in Dash0.
OTEL_LOG_LEVEL=info

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
